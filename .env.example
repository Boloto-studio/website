# YouTube Integration Configuration
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=your_channel_id_here

# Example:
# YOUTUBE_API_KEY=AIzaSyDGXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# Environment
ENVIRONMENT=development

# S3 media storage via self-hosted RustFS (production only; development uses the local media/ directory)
S3_ENDPOINT_URL=https://s3.example.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
# RustFS accepts any region; us-east-1 is the default
S3_REGION=us-east-1
# Optional: public host (no scheme) serving the bucket, e.g. s3.boloto.studio/<bucket>
S3_PUBLIC_DOMAIN=
# Optional: key prefix inside the bucket (default: media)
S3_LOCATION=media
# Set to true if the bucket is private (generates signed, expiring URLs)
S3_SIGNED_URLS=false
